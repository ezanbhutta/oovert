---
permalink: "/brand-guidelines/index.html"
---
{%- set currentPath = "/brand-guidelines/" -%}
<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
  <meta charset="UTF-8">
  {% include "analytics.njk" %}
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Brand Guidelines &amp; Brand Style Guides · OOVERT</title>
  <meta name="description" content="Brand guidelines and brand style guides your team can follow: logo, colour, type, voice and motion rules that keep a brand consistent. From $280.">
  <link rel="canonical" href="https://oovert.com/brand-guidelines/">
  <meta name="theme-color" content="#F3F0E9">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="OOVERT">
  <meta property="og:title" content="Brand Guidelines · OOVERT">
  <meta property="og:description" content="Brand guidelines and style guides your team can actually follow. The rules that keep a brand consistent everywhere.">
  <meta property="og:url" content="https://oovert.com/brand-guidelines/">
  <meta property="og:image" content="https://oovert.com/assets/og/brand-guidelines.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <script>document.documentElement.classList.replace('no-js', 'js');</script>

  <link rel="preload" href="/assets/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/instrument-serif-italic.woff2" as="font" type="font/woff2" crossorigin>

  <link rel="stylesheet" href="/css/foundation.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/sections.css">
  <link rel="stylesheet" href="/css/work.css">

  <link rel="modulepreload" href="/js/modules/reveal.js">
  <link rel="modulepreload" href="/js/modules/nav.js">
  {% set schemaKey = "brand-guidelines" %}{% include "schema.njk" %}
</head>
<body class="page-brand-guidelines">
  <a class="skip-link" href="#main">{{ site.a11y.skipLink }}</a>

  {% include "site-header.njk" %}

  <main id="main" class="brand-guidelines">
    <header class="work-hero" id="top">
      <p class="work-hero__eyebrow" data-reveal>{{ brandGuidelines.eyebrow }}</p>
      <h1 class="work-hero__title" data-reveal-lines>
        <span class="line"><span class="line__inner">One brand.</span></span>
        <span class="line"><span class="line__inner">One <em>rulebook.</em></span></span>
      </h1>
      <p class="work-hero__lede" data-reveal>{{ brandGuidelines.lede }}</p>
    </header>

    <section class="bi-parts" aria-label="What a brand style guide covers">
      <h2 class="bi-parts__intro" data-reveal>{{ brandGuidelines.parts.intro }}</h2>
      <dl class="bi-parts__list">
        {% for part in brandGuidelines.parts.items %}<div class="bi-parts__row" data-reveal>
          <dt class="bi-parts__name">{{ part.name }}</dt>
          <dd class="bi-parts__desc">{{ part.desc }}</dd>
        </div>
        {% endfor %}</dl>
    </section>

    <section class="cost-why" aria-label="Guidelines, done right">
      <p class="cost-why__text" data-reveal-lines>
        <span class="line"><span class="line__inner">{{ brandGuidelines.strategy.line | safe }}</span></span>
      </p>
      <p class="bi-note" data-reveal>{{ brandGuidelines.strategy.note | safe }}</p>
    </section>

    <section class="work-more">
      <p class="work-more__line" data-reveal-lines>
        <span class="line"><span class="line__inner">{{ brandGuidelines.proof.line | safe }}</span></span>
      </p>
      <p class="work-more__note" data-reveal>{{ brandGuidelines.proof.note }}</p>
      <a class="work-more__cta" href="{{ brandGuidelines.proof.ctaUrl }}" data-reveal>{{ brandGuidelines.proof.ctaLabel }} <span aria-hidden="true">&rarr;</span></a>
    </section>

    <section class="faq-section" id="faq" aria-labelledby="bg-faq-title">
      <header class="chapter-head" data-reveal-head>
        <h2 class="chapter-head__label" id="bg-faq-title">Guidelines, answered.</h2>
      </header>
      <div class="faq">
        {% for item in brandGuidelines.faq %}<details class="faq__item"{% if loop.first %} open{% endif %}>
          <summary class="faq__q">
            <span class="faq__q-text">{{ item.q }}</span>
            <span class="faq__marker" aria-hidden="true"></span>
          </summary>
          <div class="faq__a"><p>{{ item.a | safe }}</p></div>
        </details>
        {% endfor %}</div>
    </section>

    <section class="work-more">
      <p class="work-more__line" data-reveal-lines>
        <span class="line"><span class="line__inner">{{ brandGuidelines.closing.line | safe }}</span></span>
      </p>
      <p class="work-more__note" data-reveal>{{ brandGuidelines.closing.note }}</p>
      <a class="work-more__cta" href="{{ brandGuidelines.closing.ctaUrl }}" data-reveal>{{ brandGuidelines.closing.ctaLabel }} <span aria-hidden="true">&rarr;</span></a>
    </section>
  </main>

  {% include "site-footer.njk" %}

  <script type="module" src="/js/work.js"></script>
</body>
</html>
