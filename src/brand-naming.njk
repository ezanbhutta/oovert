---
permalink: "/brand-naming/index.html"
---
{%- set currentPath = "/brand-naming/" -%}
<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
  <meta charset="UTF-8">
  {% include "analytics.njk" %}
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Brand Naming Agency · Company & Product Names · OOVERT</title>
  <meta name="description" content="Brand naming agency for company and product names, memorable, ownable and strategy-first. We name companies, then build the brand around the name. From $280.">
  <link rel="canonical" href="https://oovert.com/brand-naming/">
  <meta name="theme-color" content="#F3F0E9">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="OOVERT">
  <meta property="og:title" content="Brand Naming, OOVERT">
  <meta property="og:description" content="A brand naming agency for company and product names, memorable, ownable, and strategy-first.">
  <meta property="og:url" content="https://oovert.com/brand-naming/">
  <meta property="og:image" content="https://oovert.com/assets/og/brand-naming.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="/favicon.ico?v={{ assets.icon }}" sizes="any">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <script>document.documentElement.classList.replace('no-js', 'js');</script>

  <link rel="preload" href="/assets/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/instrument-serif-italic.woff2" as="font" type="font/woff2" crossorigin>

  <link rel="stylesheet" href="/css/foundation.css?v={{ assets.css }}">
  <link rel="stylesheet" href="/css/components.css?v={{ assets.css }}">
  <link rel="stylesheet" href="/css/sections.css?v={{ assets.css }}">
  <link rel="stylesheet" href="/css/work.css?v={{ assets.css }}">

  <link rel="modulepreload" href="/js/modules/reveal.js">
  <link rel="modulepreload" href="/js/modules/nav.js">
  {% set schemaKey = "brand-naming" %}{% include "schema.njk" %}
</head>
<body class="page-brand-naming">
  <a class="skip-link" href="#main">{{ site.a11y.skipLink }}</a>

  {% include "site-header.njk" %}

  <main id="main" class="brand-naming">
    <header class="work-hero" id="top">
      <p class="work-hero__eyebrow" data-reveal>{{ brandNaming.eyebrow }}</p>
      <h1 class="work-hero__title" data-reveal-lines>
        <span class="line"><span class="line__inner">A <span class="ink-mark nt"><span class="visually-hidden">name</span><span class="nt__l" aria-hidden="true" style="--i:0">n</span><span class="nt__l" aria-hidden="true" style="--i:1">a</span><span class="nt__l" aria-hidden="true" style="--i:2">m</span><span class="nt__l" aria-hidden="true" style="--i:3">e</span></span> that</span></span>
        <span class="line"><span class="line__inner"><em>travels.</em></span></span>
      </h1>
      <p class="work-hero__lede" data-reveal>{{ brandNaming.lede }}</p>
      {% set instFig = "05" %}{% set instNote = "Said · spelled · kept" %}{% include "hero-instrument.njk" %}
    </header>

    <section class="bi-parts blueprint" aria-label="What our naming covers">
      <h2 class="bi-parts__intro" data-reveal>{{ brandNaming.parts.intro }}</h2>
      <dl class="bi-parts__list">
        {% for part in brandNaming.parts.items %}<div class="bi-parts__row" data-reveal>
          <dt class="bi-parts__name">{{ part.name }}</dt>
          <dd class="bi-parts__desc">{{ part.desc }}</dd>
        </div>
        {% endfor %}</dl>
    </section>

    <section class="cost-why" aria-label="Naming, strategy-first">
      <p class="cost-why__text" data-reveal-lines>
        <span class="line"><span class="line__inner">{{ brandNaming.strategy.line | safe }}</span></span>
      </p>
      <p class="bi-note" data-reveal>{{ brandNaming.strategy.note | safe }}</p>
    </section>

    <section class="work-more">
      <p class="work-more__line" data-reveal-lines>
        <span class="line"><span class="line__inner">{{ brandNaming.proof.line | safe }}</span></span>
      </p>
      <p class="work-more__note" data-reveal>{{ brandNaming.proof.note }}</p>
      <a class="work-more__cta" href="{{ brandNaming.proof.ctaUrl }}" data-reveal>{{ brandNaming.proof.ctaLabel }} <span aria-hidden="true">&rarr;</span></a>
    </section>

    <section class="faq-section" id="faq" aria-labelledby="bn-faq-title">
      <header class="chapter-head" data-reveal-head>
        <h2 class="chapter-head__label" id="bn-faq-title">Naming, answered.</h2>
      </header>
      <div class="faq">
        {% for item in brandNaming.faq %}<details class="faq__item"{% if loop.first %} open{% endif %}>
          <summary class="faq__q">
            <span class="faq__q-text">{{ item.q }}</span>
            <span class="faq__marker" aria-hidden="true"></span>
          </summary>
          <div class="faq__a"><p>{{ item.a | safe }}</p></div>
        </details>
        {% endfor %}</div>
    </section>

    <section class="work-more">
      <p class="work-more__line" data-reveal-lines>
        <span class="line"><span class="line__inner">{{ brandNaming.closing.line | safe }}</span></span>
      </p>
      <p class="work-more__note" data-reveal>{{ brandNaming.closing.note }}</p>
      <a class="work-more__cta" href="{{ brandNaming.closing.ctaUrl }}" data-reveal>{{ brandNaming.closing.ctaLabel }} <span aria-hidden="true">&rarr;</span></a>
    </section>
  </main>

  {% include "site-footer.njk" %}

  <script type="module" src="/js/work.js"></script>
</body>
</html>
