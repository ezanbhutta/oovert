---
permalink: "/brand-identity/index.html"
---
{%- set currentPath = "/brand-identity/" -%}
<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
  <meta charset="UTF-8">
  {% include "analytics.njk" %}
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Brand Identity Design, Strategy-First — OOVERT</title>
  <meta name="description" content="Brand identity design done strategy-first: name, logo, type, colour, voice and motion built into one system people recognise before they read. From $280.">
  <link rel="canonical" href="https://oovert.com/brand-identity/">
  <meta name="theme-color" content="#F3F0E9">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="OOVERT">
  <meta property="og:title" content="Brand Identity Design — OOVERT">
  <meta property="og:description" content="Strategy-first brand identity — name, mark, type, colour, voice and motion, recognised before it is read.">
  <meta property="og:url" content="https://oovert.com/brand-identity/">
  <meta property="og:image" content="https://oovert.com/assets/og/brand-identity.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <script>document.documentElement.classList.replace('no-js', 'js');</script>

  <link rel="preload" href="/assets/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/instrument-serif-italic.woff2" as="font" type="font/woff2" crossorigin>

  <link rel="stylesheet" href="/css/foundation.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/sections.css">
  <link rel="stylesheet" href="/css/work.css">

  <link rel="modulepreload" href="/js/modules/reveal.js">
  <link rel="modulepreload" href="/js/modules/nav.js">
  {% set schemaKey = "brand-identity" %}{% include "schema.njk" %}
</head>
<body class="page-brand-identity">
  <a class="skip-link" href="#main">{{ site.a11y.skipLink }}</a>

  {% include "site-header.njk" %}

  <main id="main" class="brand-identity">
    <header class="work-hero" id="top">
      <p class="work-hero__eyebrow" data-reveal>{{ brandIdentity.eyebrow }}</p>
      <h1 class="work-hero__title" data-reveal-lines>
        <span class="line"><span class="line__inner">Recognised before</span></span>
        <span class="line"><span class="line__inner">it is <em>read.</em></span></span>
      </h1>
      <p class="work-hero__lede" data-reveal>{{ brandIdentity.lede }}</p>
    </header>

    <!-- What a brand identity is made of -->
    <section class="bi-parts" aria-label="What a brand identity is made of">
      <p class="bi-parts__intro" data-reveal>{{ brandIdentity.parts.intro }}</p>
      <dl class="bi-parts__list">
        {% for part in brandIdentity.parts.items %}<div class="bi-parts__row" data-reveal>
          <dt class="bi-parts__name">{{ part.name }}</dt>
          <dd class="bi-parts__desc">{{ part.desc }}</dd>
        </div>
        {% endfor %}</dl>
    </section>

    <!-- Strategy-first -->
    <section class="cost-why" aria-label="Strategy-first brand identity">
      <p class="cost-why__text" data-reveal-lines>
        <span class="line"><span class="line__inner">{{ brandIdentity.strategy.line | safe }}</span></span>
      </p>
      <p class="bi-note" data-reveal>{{ brandIdentity.strategy.note | safe }}</p>
    </section>

    <!-- Proof -->
    <section class="work-more">
      <p class="work-more__line" data-reveal-lines>
        <span class="line"><span class="line__inner">{{ brandIdentity.proof.line | safe }}</span></span>
      </p>
      <p class="work-more__note" data-reveal>{{ brandIdentity.proof.note }}</p>
      <a class="work-more__cta" href="{{ brandIdentity.proof.ctaUrl }}" data-reveal>{{ brandIdentity.proof.ctaLabel }} <span aria-hidden="true">&rarr;</span></a>
    </section>

    <!-- FAQ -->
    <section class="faq-section" id="faq" aria-labelledby="bi-faq-title">
      <header class="chapter-head" data-reveal-head>
        <h2 class="chapter-head__label" id="bi-faq-title">Brand identity, answered.</h2>
      </header>
      <div class="faq">
        {% for item in brandIdentity.faq %}<details class="faq__item"{% if loop.first %} open{% endif %}>
          <summary class="faq__q">
            <span class="faq__q-text">{{ item.q }}</span>
            <span class="faq__marker" aria-hidden="true"></span>
          </summary>
          <div class="faq__a"><p>{{ item.a | safe }}</p></div>
        </details>
        {% endfor %}</div>
    </section>

    <!-- Close -->
    <section class="work-more">
      <p class="work-more__line" data-reveal-lines>
        <span class="line"><span class="line__inner">{{ brandIdentity.closing.line | safe }}</span></span>
      </p>
      <p class="work-more__note" data-reveal>{{ brandIdentity.closing.note }}</p>
      <a class="work-more__cta" href="{{ brandIdentity.closing.ctaUrl }}" data-reveal>{{ brandIdentity.closing.ctaLabel }} <span aria-hidden="true">&rarr;</span></a>
    </section>
  </main>

  {% include "site-footer.njk" %}

  <script type="module" src="/js/work.js"></script>
</body>
</html>
