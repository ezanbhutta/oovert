---
permalink: "/rebranding/index.html"
---
{%- set currentPath = "/rebranding/" -%}
<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
  <meta charset="UTF-8">
  {% include "analytics.njk" %}
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rebranding Agency — Strategy-Led Rebrands — OOVERT</title>
  <meta name="description" content="Rebranding agency for strategy-led rebrands: sharper strategy, positioning and identity that matches who you've become, without losing your brand equity.">
  <link rel="canonical" href="https://oovert.com/rebranding/">
  <meta name="theme-color" content="#F3F0E9">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="OOVERT">
  <meta property="og:title" content="Rebranding — OOVERT">
  <meta property="og:description" content="Strategy-led rebranding — new strategy, position and identity, without throwing away the equity you have earned.">
  <meta property="og:url" content="https://oovert.com/rebranding/">
  <meta property="og:image" content="https://oovert.com/assets/og/rebranding.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <script>document.documentElement.classList.replace('no-js', 'js');</script>

  <link rel="preload" href="/assets/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/instrument-serif-italic.woff2" as="font" type="font/woff2" crossorigin>

  <link rel="stylesheet" href="/css/foundation.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/sections.css">
  <link rel="stylesheet" href="/css/work.css">

  <link rel="modulepreload" href="/js/modules/reveal.js">
  <link rel="modulepreload" href="/js/modules/nav.js">
  {% set schemaKey = "rebranding" %}{% include "schema.njk" %}
</head>
<body class="page-rebranding">
  <a class="skip-link" href="#main">{{ site.a11y.skipLink }}</a>

  {% include "site-header.njk" %}

  <main id="main" class="rebranding">
    <header class="work-hero" id="top">
      <p class="work-hero__eyebrow" data-reveal>{{ rebranding.eyebrow }}</p>
      <h1 class="work-hero__title" data-reveal-lines>
        <span class="line"><span class="line__inner">For the companies</span></span>
        <span class="line"><span class="line__inner">the world <em>stopped seeing.</em></span></span>
      </h1>
      <p class="work-hero__lede" data-reveal>{{ rebranding.lede }}</p>
    </header>

    <section class="bi-parts" aria-label="What a rebrand touches">
      <h2 class="bi-parts__intro" data-reveal>{{ rebranding.parts.intro }}</h2>
      <dl class="bi-parts__list">
        {% for part in rebranding.parts.items %}<div class="bi-parts__row" data-reveal>
          <dt class="bi-parts__name">{{ part.name }}</dt>
          <dd class="bi-parts__desc">{{ part.desc }}</dd>
        </div>
        {% endfor %}</dl>
    </section>

    <section class="cost-why" aria-label="Rebranding, done right">
      <p class="cost-why__text" data-reveal-lines>
        <span class="line"><span class="line__inner">{{ rebranding.strategy.line | safe }}</span></span>
      </p>
      <p class="bi-note" data-reveal>{{ rebranding.strategy.note | safe }}</p>
    </section>

    <section class="work-more">
      <p class="work-more__line" data-reveal-lines>
        <span class="line"><span class="line__inner">{{ rebranding.proof.line | safe }}</span></span>
      </p>
      <p class="work-more__note" data-reveal>{{ rebranding.proof.note }}</p>
      <a class="work-more__cta" href="{{ rebranding.proof.ctaUrl }}" data-reveal>{{ rebranding.proof.ctaLabel }} <span aria-hidden="true">&rarr;</span></a>
    </section>

    <section class="faq-section" id="faq" aria-labelledby="rb-faq-title">
      <header class="chapter-head" data-reveal-head>
        <h2 class="chapter-head__label" id="rb-faq-title">Rebranding, answered.</h2>
      </header>
      <div class="faq">
        {% for item in rebranding.faq %}<details class="faq__item"{% if loop.first %} open{% endif %}>
          <summary class="faq__q">
            <span class="faq__q-text">{{ item.q }}</span>
            <span class="faq__marker" aria-hidden="true"></span>
          </summary>
          <div class="faq__a"><p>{{ item.a | safe }}</p></div>
        </details>
        {% endfor %}</div>
    </section>

    <section class="work-more">
      <p class="work-more__line" data-reveal-lines>
        <span class="line"><span class="line__inner">{{ rebranding.closing.line | safe }}</span></span>
      </p>
      <p class="work-more__note" data-reveal>{{ rebranding.closing.note }}</p>
      <a class="work-more__cta" href="{{ rebranding.closing.ctaUrl }}" data-reveal>{{ rebranding.closing.ctaLabel }} <span aria-hidden="true">&rarr;</span></a>
    </section>
  </main>

  {% include "site-footer.njk" %}

  <script type="module" src="/js/work.js"></script>
</body>
</html>
