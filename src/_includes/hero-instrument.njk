{#- THE MARK, IN SPACE.
    The sub-page hero figure: the brand's double-o built as a real 3D assembly
    rather than a flat plate. Each ring, the grid plane behind them and the
    lens core sit at their own depth inside a perspective stage, so moving the
    pointer tilts the whole construction and the layers part with genuine
    parallax. Drawing near the centre pulls the two rings into register: the
    mark resolving, the same gesture as the header wordmark.
    instKind picks the arrangement per page; markmotion.js drives it. -#}
<figure class="hero-instrument hero-instrument--{{ instKind | default('eclipse') }}" data-mark3d aria-hidden="true">
  <div class="hi__stage">
    <div class="hi__space">

      <span class="hi__layer hi__layer--plane">
        <svg viewBox="0 0 400 400" fill="none" preserveAspectRatio="xMidYMid meet">
          <path d="M0 200H400M200 0V400" class="hi__axis" vector-effect="non-scaling-stroke"/>
          <path d="M60 200H340M200 60V340" class="hi__axis hi__axis--in" vector-effect="non-scaling-stroke"/>
          <circle cx="200" cy="200" r="176" class="hi__guide" vector-effect="non-scaling-stroke"/>
        </svg>
      </span>

      <span class="hi__layer hi__layer--a">
        <svg viewBox="0 0 400 400" fill="none" preserveAspectRatio="xMidYMid meet">
          <circle cx="200" cy="200" r="132" class="hi__ring hi__ring--ink" vector-effect="non-scaling-stroke"/>
        </svg>
      </span>

      <span class="hi__layer hi__layer--b">
        <svg viewBox="0 0 400 400" fill="none" preserveAspectRatio="xMidYMid meet">
          <circle cx="200" cy="200" r="132" class="hi__ring hi__ring--violet" vector-effect="non-scaling-stroke"/>
        </svg>
      </span>

      <span class="hi__layer hi__layer--ticks">
        <svg viewBox="0 0 400 400" fill="none" preserveAspectRatio="xMidYMid meet">
          <path d="M200 40V72M200 328V360M40 200H72M328 200H360" class="hi__tick" vector-effect="non-scaling-stroke"/>
        </svg>
      </span>

      <span class="hi__layer hi__layer--core"><i></i></span>

    </div>
  </div>
  <span class="hi__note">{{ instNote }}</span>
</figure>
